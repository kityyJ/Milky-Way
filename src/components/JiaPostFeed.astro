---
const limit = Math.max(1, Math.min(Number(Astro.props.limit) || 4, 12));
const initialPosts = [];
---
<div class="jia-feed" data-jia-posts data-limit={limit} aria-live="polite">
  {initialPosts.length ? (
    <ul class="jia-post-list">
      {initialPosts.map((post) => (
        <li class="jia-post">
          {post.cover && <img class="jia-post__cover" src={post.cover} alt="" loading="lazy" decoding="async">}
          <div class="jia-post__content">
            <time class="jia-post__date" datetime={post.publishedAt}>{post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US') : 'JIA BLOG'}</time>
            <h3><a href={post.url} target="_blank" rel="noopener noreferrer">{post.title}</a></h3>
            <p>{post.excerpt}</p>
            <a class="jia-post__more" href={post.url} target="_blank" rel="noopener noreferrer">Read more →</a>
          </div>
        </li>
      ))}
    </ul>
  ) : <p class="jia-feed__empty">Loading pinned posts from JIA BLOG…</p>}
</div>
<script>
  type JiaPost = { title?: string; excerpt?: string; url?: string; cover?: string; publishedAt?: string };
  const formatDate = (value?: string) => {
    if (!value) return "JIA BLOG";
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? "JIA BLOG" : date.toLocaleDateString("en-US");
  };
  function renderPosts(container: HTMLElement, posts: JiaPost[]) {
    const list = document.createElement("ul");
    list.className = "jia-post-list";
    for (const post of posts) {
      if (!post.title || !post.url || !post.url.startsWith("https://blog.jia.nz/")) continue;
      const item = document.createElement("li");
      item.className = "jia-post";
      if (post.cover && post.cover.startsWith("https://")) {
        const image = document.createElement("img");
        image.className = "jia-post__cover";
        image.src = post.cover;
        image.alt = "";
        image.loading = "lazy";
        image.decoding = "async";
        item.append(image);
      }
      const content = document.createElement("div");
      content.className = "jia-post__content";
      const date = document.createElement("time");
      date.className = "jia-post__date";
      date.dateTime = post.publishedAt || "";
      date.textContent = formatDate(post.publishedAt);
      const heading = document.createElement("h3");
      const title = document.createElement("a");
      title.href = post.url;
      title.target = "_blank";
      title.rel = "noopener noreferrer";
      title.textContent = post.title;
      heading.append(title);
      const excerpt = document.createElement("p");
      excerpt.textContent = post.excerpt || "";
      const more = document.createElement("a");
      more.className = "jia-post__more";
      more.href = post.url;
      more.target = "_blank";
      more.rel = "noopener noreferrer";
      more.textContent = "Read more →";
      content.append(date, heading, excerpt, more);
      item.append(content);
      list.append(item);
    }
    if (list.children.length) container.replaceChildren(list);
    else container.textContent = "No pinned posts are available.";
  }
  document.querySelectorAll<HTMLElement>("[data-jia-posts]").forEach(async (container) => {
    try {
      const response = await fetch("/api/jia-posts", { cache: "no-store" });
      if (!response.ok) throw new Error("Feed unavailable");
      const payload = await response.json() as { posts?: JiaPost[] };
      if (Array.isArray(payload.posts)) {
        renderPosts(container, payload.posts.slice(0, Number(container.dataset.limit) || 4));
      }
    } catch {
      container.textContent = "Pinned posts are temporarily unavailable. Please visit JIA BLOG.";
    }
  });
</script>
