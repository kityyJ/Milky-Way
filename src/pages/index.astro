---
import Layout from '../layouts/Layout.astro';
import JiaPostFeed from '../components/JiaPostFeed.astro';
const pageTitle = "Home";
---
<Layout pageTitle={pageTitle}>
  <div class="gif">
    <img src="/images/cook_avatar_typing_site.webp" alt="JIA's animated avatar" width="300" height="259" decoding="async">
  </div>
  <h1>JIA</h1>
  <span class="badge">Daily Life &amp; Lifestyle Sharing</span>
  <h2>About</h2>
  <p>
    Welcome to my personal space on the web. I write about everyday life, things I have learned, and the digital tools and technology I enjoy exploring.
  </p>
  <p>
    There is no single topic here. You will find practical guides, notes on devices and networking, open-source projects, games, AI tools, and moments from daily life.
  </p>
  <div class="center">
    <a href="https://blog.jia.nz/" target="_blank" rel="noopener noreferrer">
      <button class="btn">Visit My Blog</button>
    </a>
  </div>
  <h2>Latest Pinned Post</h2>
  <JiaPostFeed limit={1} />
  <p class="blog-more"><a href="/posts/">View all pinned posts →</a></p>
  <h2>Interests</h2>
  <p>
    I enjoy keeping useful notes, sharing what works, and turning everyday discoveries into practical references for others.
  </p>
</Layout>
