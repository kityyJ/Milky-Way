---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Works";
---
<Layout pageTitle={pageTitle}>
  <div class="gif">
    <img src="/images/laptop.webp" alt="JIA's digital and development projects" width="300" height="259" decoding="async">
  </div>
  <h2>Projects</h2>
  <ul class="project-list">
    <li class="project-card">
      <span class="badge">Open-source tool</span>
      <h2>Cook Speed DNS</h2>
      <p>Aggregates Cloudflare IPv4 candidates, groups them by China Telecom, Unicom, and Mobile, and provides TXT and JSON data.</p>
      <div class="project-links">
        <a href="https://github.com/kityyJ/cook-speed-dns" target="_blank" rel="noopener noreferrer">View on GitHub →</a>
        <a href="https://kityyj.github.io/cook-speed-dns/" target="_blank" rel="noopener noreferrer">Open project demo →</a>
      </div>
    </li>
    <li class="project-card">
      <span class="badge">Personal blog</span>
      <h2>JIA BLOG</h2>
      <p>A personal blog for daily life, practical experience, digital tools, and technology notes.</p>
      <div class="project-links">
        <a href="https://www.jia.nz/" target="_blank" rel="noopener noreferrer">Visit JIA BLOG →</a>
        <a href="https://www.jia.nz/site/about/" target="_blank" rel="noopener noreferrer">About the blog →</a>
      </div>
    </li>
  </ul>
</Layout>
