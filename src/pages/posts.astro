---
import Layout from "../layouts/Layout.astro";
import JiaPostFeed from "../components/JiaPostFeed.astro";
const pageTitle = "Blog";
---
<Layout pageTitle={pageTitle}>
  <div class="gif">
    <img src="/images/blog.webp" alt="Blog notes" width="300" height="259" decoding="async">
  </div>
  <h2>Latest Pinned Posts</h2>
  <p>These posts come from the current public pinned list on JIA BLOG, ordered by featured priority and publication date.</p>
  <JiaPostFeed limit={12} />
  <p class="blog-more"><a href="https://blog.jia.nz/" target="_blank" rel="noopener noreferrer">Visit JIA BLOG for all posts →</a></p>
</Layout>
