---
import Layout from '../layouts/Layout.astro';
---
<Layout pageTitle="Page Not Found">
  <div class="lost">
    <div class="gif">
      <img src="/images/404.webp" alt="" width="300" height="259" decoding="async">
    </div>
    <h1 class="lost__header">404</h1>
    <p class="lost__body">This page seems to be missing. Head back to JIA's home page and keep exploring.</p>
    <p><a class="lost__link" href="/">Return Home</a></p>
  </div>
</Layout>
